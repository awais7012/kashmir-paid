NODE_ENV=development
PORT=4000

# --- MySQL ---
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://root@127.0.0.1:3306/kashmir_connect

# --- Auth ---
# Must be at least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d

# Comma separated list of browser origins allowed to call this API. Use * to allow all.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:3000

BCRYPT_ROUNDS=10

# --- Uploads ---
# Where uploaded images and videos are written, served at /uploads
UPLOAD_DIR=./uploads
MAX_IMAGE_MB=8
MAX_VIDEO_MB=200

# --- Seed script (first admin account) ---
SEED_ADMIN_EMAIL=admin@gktv.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=GKTV Admin
