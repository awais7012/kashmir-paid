# Base URL of the Express API in ./server
VITE_API_URL="http://localhost:4000"

# The language this deployment publishes in: "en" (default) or "ur".
# One language per deployment — set at build/dev time, e.g. `SITE_LANG=ur npm run dev`.
# Stories in the other language are filtered out, and only this language's fonts load.
SITE_LANG="en"
